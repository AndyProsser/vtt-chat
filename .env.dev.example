# =============================================================================
# VTT-Chat — Development environment
# Copy to .env and adjust before running: docker compose -f docker-compose.dev.yml up
# This file is loaded automatically by Docker Compose for ${VAR} substitution
# and is also passed to the backend container via env_file.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=devpassword

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=devredis

# ---------------------------------------------------------------------------
# LiveKit (voice rooms)
# These values are injected into the livekit container via LIVEKIT_KEYS
# and read by the backend to sign tokens.
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ---------------------------------------------------------------------------
# Backend — JWT
# ---------------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_ADMIN_SECRET=dev-admin-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# Backend — general
# NODE_ENV and DATABASE_URL/REDIS_URL/LIVEKIT_URL are set by docker-compose
# environment: block and take precedence over these values.
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Frontend build args (VITE_* — baked into the SPA bundle at build time)
# In dev the docker-compose environment: block sets these on the Vite dev
# server directly, so these values are used only for production-style builds.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_LIVEKIT_URL=ws://localhost:7880
