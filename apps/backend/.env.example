# Database
# Use a secure password for production
DATABASE_URL=postgresql://localhost/vtt-chat
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis
# Use a secure password for production
REDIS_PASSWORD=your-secure-redis-password-here

# JWT
# Use a long, random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# LiveKit (voice/video)
# Get your API key and secret from LiveKit console
# Local dev: use the same values in docker-compose.dev.yml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Server
# Host and port for the backend server
HOST=0.0.0.0
PORT=3000

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Session cleanup scheduler
# Poll interval (minutes) for scanning CLEANUP sessions.
SESSION_CLEANUP_JOB_INTERVAL_MINUTES=5
# Minimum time (minutes) a session must remain in CLEANUP before purge/reset.
SESSION_CLEANUP_MIN_AGE_MINUTES=20
