# Backend API URL
# Local dev: http://localhost:3000
# Docker dev: http://localhost:8080/api (via Caddy) or use docker-compose proxying
VITE_BACKEND_URL=http://localhost:3000

# LiveKit WebSocket URL
# Local dev: ws://localhost:7880
# Docker dev: ws://localhost:8080/livekit (via Caddy)
VITE_LIVEKIT_URL=ws://localhost:7880

# LiveKit room transition handoff (experimental)
# 1 = keep previous room alive while target room connects, then swap/drop
# 0 = legacy disconnect then reconnect behavior
VITE_LIVEKIT_DUAL_ROOM_HANDOFF=0
# Max overlap window in milliseconds before rollback + legacy fallback
VITE_LIVEKIT_DUAL_ROOM_HANDOFF_MAX_MS=2500
# Publish to both old+new rooms only during overlap for voice continuity
VITE_LIVEKIT_DUAL_ROOM_MIRROR_PUBLISH=0
# Hard timeout for mirror publish on the target room during overlap
VITE_LIVEKIT_DUAL_ROOM_MIRROR_MAX_MS=900

# API URL (for REST calls, used by proxy)
VITE_API_URL=http://localhost:3000

# Frontend console log level
# Options: DEBUG, INFO, WARN, ERROR
VITE_LOG_LEVEL=DEBUG

# Frontend memory-pressure guard (beta safety valve)
# Threshold may be set in bytes or MB. If both are set, *_BYTES wins.
# Defaults in code: ~1 GB threshold, 30s poll, 15s reload grace, 5m cooldown.
# Dev-only simulator: off | warn | reload
# - warn: always show the warning toast
# - reload: show the toast and allow the forced-refresh path to execute
VITE_MEMORY_PRESSURE_THRESHOLD_MB=1000
VITE_MEMORY_PRESSURE_POLL_MS=30000
VITE_MEMORY_PRESSURE_RELOAD_GRACE_MS=15000
VITE_MEMORY_PRESSURE_RELOAD_COOLDOWN_MS=300000
VITE_DEBUG_MEMORY_PRESSURE=off

# Environment
# Options: development, production
VITE_ENV=development
