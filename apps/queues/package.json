{
  "name": "vtt-chat-queues",
  "version": "0.9.0",
  "license": "AGPL-3.0-only",
  "description": "Durable BullMQ job queue service for VTT-Chat.",
  "type": "module",
  "main": "dist/apps/queues/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/apps/queues/src/index.js",
    "lint": "eslint . --ext .ts,.js",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "express": "^5.1.0",
    "ioredis": "5.10.1",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  }
}
