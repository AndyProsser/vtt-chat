# =============================================================================
# VTT-Chat — Production environment
# Copy to .env and fill in ALL values before running: docker compose up
# NEVER commit .env to version control — it contains secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# Use a strong random password: openssl rand -base64 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGEME_strong_postgres_password

# ---------------------------------------------------------------------------
# Redis
# Use a strong random password: openssl rand -base64 24
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_strong_redis_password

# ---------------------------------------------------------------------------
# LiveKit (voice rooms)
# Generate a key/secret pair:
#   livekit-server generate-keys
# OR use any 20+ character key and 32+ character secret.
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=CHANGEME_livekit_api_key
LIVEKIT_API_SECRET=CHANGEME_livekit_api_secret_min_32_chars

# ---------------------------------------------------------------------------
# Backend — JWT
# Generate secrets: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGEME_very_long_random_jwt_secret_min_32_chars
JWT_ADMIN_SECRET=CHANGEME_very_long_random_admin_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# Backend — general
# NODE_ENV and DATABASE_URL/REDIS_URL/LIVEKIT_URL are set by the
# docker-compose environment: block and take precedence over these values.
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Comma-separated list of origins allowed to make cross-origin requests.
# Set to your public domain (no trailing slash).
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---------------------------------------------------------------------------
# Frontend build args (VITE_* — baked into the SPA bundle at build time)
# These must match the public URL where Caddy is reachable from the browser.
# ---------------------------------------------------------------------------
VITE_API_URL=https://your-domain.com:8443
VITE_WS_URL=wss://your-domain.com:8443
# LiveKit WebRTC — clients connect directly; expose port 7880 publicly or use
# a separate LiveKit Cloud / SFU endpoint.
VITE_LIVEKIT_URL=wss://your-domain.com:7880

# ---------------------------------------------------------------------------
# Caddy TLS (production)
# Place your certificate and key in caddy/certs/ before starting the stack.
# For Let's Encrypt automatic TLS, replace the self-signed tls directive in
# Caddyfile with: tls {$CADDY_ACME_EMAIL}
# ---------------------------------------------------------------------------
# CADDY_ACME_EMAIL=you@your-domain.com
