name: QA Gates

# TEMPORARILY DISABLED - Re-enable when development velocity no longer requires rapid check-ins.
# on:
#   pull_request:
#   push:
#     branches:
#       - main

jobs:
  qa-gates:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 26
          cache: npm
          cache-dependency-path: |
            package-lock.json
            backend/package-lock.json
            frontend/package-lock.json
            admin/package-lock.json

      - name: Install workspace dependencies
        run: npm ci

      - name: Lint workspace
        run: npm run lint

      - name: Build workspace
        run: npm run build

      - name: Run coverage suites
        run: npm run test:coverage

      - name: Enforce coverage gates
        run: npm run qa:coverage-report

      - name: Enforce flaky integration threshold
        run: npm run qa:flaky-tests:ci

      - name: Persist coverage gate report
        run: npm run qa:coverage-report:json > coverage-gate-report.json

      - name: Upload QA artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: qa-gates
          path: |
            coverage-gate-report.json
            backend/coverage/flaky-tests-report.json
            backend/coverage/coverage-summary.json
            frontend/coverage/coverage-summary.json
            admin/coverage/coverage-summary.json
