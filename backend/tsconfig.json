{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared": ["../shared/index.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/bootstrap.ts",
    "src/api/**/*.ts",
    "src/core/**/*.ts",
    "src/repositories/**/*.ts",
    "src/services/**/*.ts",
    "src/ws/**/*.ts",
    "src/infra/db/**/*.ts",
    "src/infra/config/**/*.ts",
    "src/infra/http/middleware.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
