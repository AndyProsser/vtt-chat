{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "@/api*": ["./src/api/*"],
      "@/types": ["./src/types/index.ts"],
      "@/types/*": ["./src/types/*"],
      "@shared": ["../shared/index.ts"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/bootstrap.ts",
    "src/api/**/*.ts",
    "src/core/**/*.ts",
    "src/repositories/**/*.ts",
    "src/services/**/*.ts",
    "src/ws/**/*.ts",
    "src/infra/db/**/*.ts",
    "src/infra/config/**/*.ts",
    "src/infra/http/middleware.ts",
    "src/utils/**/*.ts",
    "tests/**/*.ts",
    "../shared/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
