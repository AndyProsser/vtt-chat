{
  "name": "vtt-chat-backend",
  "version": "0.8.5",
  "license": "AGPL-3.0-only",
  "description": "Backend service for VTT-Chat: a DM-grade, session-aware tabletop voice & chat platform.",
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:prepare": "node scripts/container-startup.mjs",
    "build": "prisma generate && tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "lint": "eslint . --ext .ts,.js",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "start": "node dist/backend/src/index.js",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.1.4",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "tsc-alias": "^1.8.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  }
}
