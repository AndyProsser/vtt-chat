generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id          String          @id @default(uuid()) @db.Uuid
  campaignId  String?         @db.Uuid
  campaign    Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name        String
  description String?
  dmId        String          @db.Uuid
  state       SessionState    @default(IDLE)
  members     SessionMember[]
  messages    ChatMessage[]
  notes       Note[]
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  updatedAt   DateTime        @updatedAt

  @@index([dmId])
  @@index([campaignId])
  @@index([state])
  @@index([createdAt])
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String?              @unique
  username      String               @unique
  displayName   String
  avatarUrl     String?
  role          Role                 @default(PLAYER)
  campaignsDm   Campaign[]           @relation("CampaignCurrentDm")
  campaignLinks CampaignMembership[]
  characters    Character[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([username])
}

model Campaign {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  description String?
  inviteCode  String               @unique
  currentDmId String               @db.Uuid
  currentDm   User                 @relation("CampaignCurrentDm", fields: [currentDmId], references: [id], onDelete: Restrict)
  members     CampaignMembership[]
  characters  Character[]
  sessions    Session[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([currentDmId])
  @@index([createdAt])
}

model CampaignMembership {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  userId     String   @db.Uuid
  role       Role     @default(PLAYER)
  joinedAt   DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model Character {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  campaignId String   @db.Uuid
  name       String
  race       String?
  class      String?
  subclass   String?
  avatarUrl  String?
  isActive   Boolean  @default(false)
  metadata   Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([campaignId, userId])
}

model SessionMember {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  username  String
  role      Role

  joinedAt DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model ChatMessage {
  id             String      @id @default(uuid()) @db.Uuid
  sessionId      String
  session        Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId       String      @db.Uuid
  authorUsername String
  content        String      @db.Text
  type           MessageType
  isDmOnly       Boolean     @default(false)
  visibleTo      Json?
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedBy      String?     @db.Uuid

  @@index([sessionId])
  @@index([createdAt])
  @@index([type])
}

model Note {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String
  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId       String         @db.Uuid
  authorUsername String
  title          String
  content        String         @db.Text
  visibility     NoteVisibility @default(DM_ONLY)
  tags           Json?
  allowedUsers   Json?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sessionId])
  @@index([authorId])
  @@index([visibility])
  @@index([createdAt])
}

enum Role {
  DM
  PLAYER
  SPECTATOR
  SYSTEM
}

enum MessageType {
  IC
  OOC
  WHISPER
  SYSTEM
}

enum SessionState {
  IDLE
  ACTIVE
  PAUSED
  ENDED
}

enum NoteVisibility {
  DM_ONLY
  PLAYERS_VISIBLE
  CUSTOM
}
