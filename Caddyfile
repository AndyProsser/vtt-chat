{
  # Global options
  email you@example.com
}

https://:8443 {
  tls /certs/selfsigned.crt /certs/selfsigned.key
  encode gzip

  handle_path /api* {
    reverse_proxy backend:3000
  }

  handle_path /livekit* {
    reverse_proxy livekit:7880
  }

  handle_path /admin* {
    reverse_proxy admin:5174
    try_files {path} /index.html
  }

  handle {
    reverse_proxy frontend:5173
    try_files {path} /index.html
  }
}
