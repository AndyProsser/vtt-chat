{
  "name": "vtt-chat-frontend",
  "version": "0.6.0",
  "private": true,
  "description": "Frontend SPA for VTT-Chat: a DM-grade, session-aware tabletop voice & chat platform.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "VITE_DEBUG_BUILD=true vite build --mode development",
    "build:prod": "VITE_DEBUG_BUILD=false vite build --mode production",
